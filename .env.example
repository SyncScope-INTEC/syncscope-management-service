# Django Configuration
ALLOWED_HOSTS="localhost,127.0.0.1"
DEBUG="True"
SECRET_KEY="your-django-secret-key-here"

# Database Configuration
DB_HOST="localhost"
DB_NAME="syncscope"
DB_PASSWORD="your-db-password"
DB_PORT="5432"
DB_USER="postgres"
USE_SQLITE=False

# JWT Configuration
JWT_SECRET_KEY="your-jwt-secret-key-here"

# Service URLs
API_GATEWAY_URL="http://localhost:8000"
AUTH_SERVICE_URL="http://localhost:8001"
MONITORING_SERVICE_URL="http://localhost:8002"
ANALYTICS_SERVICE_URL="http://localhost:8004"
FRONTEND_URL="http://localhost:3000"

# CORS Configuration
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
CSRF_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# GitHub Integration Configuration
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Management Service Configuration
MAX_TEAM_MEMBERS=100
MAX_PROJECTS_PER_TEAM=50
MAX_INTEGRATIONS_PER_PROJECT=10
GITHUB_SYNC_INTERVAL=300
DEFAULT_COMMIT_HISTORY_LIMIT=50

# Service Communication
SERVICE_NAME="syncscope-management-service"
SERVICE_VERSION="1.0.0"